{
  "name": "Initial Setup",
  "version": "1.0.0",
  "variables": {
    "tenant": "acme"
  },
  "steps": [
    {
      "id": "create-admin",
      "type": "create-user",
      "input": {
        "email": "admin@[js: variables('tenant')].local",
        "role": "admin"
      }
    },
    {
      "id": "print-summary",
      "type": "print",
      "dependsOn": [ "create-admin" ],
      "input": {
        "message": "Configured [js: output('create-admin', 'email')]"
      }
    }
  ]
}
